server {
    listen 80;
    listen [::]:80;
    server_name www.${base_domain};

    include /etc/nginx/platform/security-headers.conf;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/platform/acme;
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location / {
        return 308 http://${base_domain}$request_uri;
    }
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${base_domain} ${elastic_ip};
    root /srv/platform/portfolio/current;
    index index.html;

    include /etc/nginx/platform/security-headers.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 200 "ok\n";
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/platform/acme;
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location = /rss.xml {
        default_type "application/rss+xml; charset=utf-8";
        add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
        try_files $uri =404;
    }

    location = /sitemap.xml {
        default_type "application/xml; charset=utf-8";
        add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
        try_files $uri =404;
    }

    location = /robots.txt {
        default_type "text/plain; charset=utf-8";
        add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
        try_files $uri =404;
    }

    location ~* \.data$ {
        default_type text/x-script;
        add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
        try_files $uri =404;
    }

    location ~* "\.[0-9a-f]{8,}\.(?:css|js|mjs|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf)$" {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ~* \.html$ {
        add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
        try_files $uri =404;
    }

    location ~* \.(?:css|js|mjs|map|json|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|pdf|xml|txt)$ {
        add_header Cache-Control "public, max-age=3600, must-revalidate" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
        try_files $uri $uri/ $uri/index.html @spa_404;
    }

    location @spa_404 {
        error_page 418 =404 /__spa-fallback.html;
        return 418;
    }

    location = /__spa-fallback.html {
        internal;
        default_type "text/html; charset=utf-8";
        add_header Cache-Control "no-store" always;
    }
}
