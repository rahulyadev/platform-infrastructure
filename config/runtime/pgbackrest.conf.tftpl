[global]
repo1-type=s3
repo1-s3-bucket=${backup_bucket}
repo1-s3-region=${aws_region}
repo1-s3-key-type=auto
repo1-path=/identity/production
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass-command=cat /run/secrets/backup/repository_cipher
repo1-retention-full=4
repo1-retention-diff=14
repo1-bundle=y
archive-async=y
spool-path=/var/spool/pgbackrest
process-max=2
log-level-console=info
log-level-file=off

[identity]
pg1-path=/var/lib/postgresql/18/docker
pg1-socket-path=/run/postgresql
pg1-user=identity_bootstrap
