#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077
set +x

write_b64gzip() {
  local encoded="$1" destination="$2" mode="$3" temporary="$2.tmp.$$" expected_metadata
  expected_metadata="$${mode#0}:$(id -u):$(id -g)"
  rm -f -- "$temporary"
  install -m "$mode" /dev/null "$temporary"
  if ! printf '%s' "$encoded" | base64 --decode | gzip --decompress >"$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  [[ -f "$temporary" && ! -L "$temporary" && "$(stat -c '%a:%u:%g' "$temporary")" == "$expected_metadata" ]]
  mv -Tf -- "$temporary" "$destination"
}

readonly -a manual_active_staging_parent_specs=(
  "etc/systemd/system:0755"
  "usr/local/libexec/platform:0755"
)

prepare_manual_active_staging_parents() {
  local staging_root="$1" expected_uid="$2" expected_gid="$3"
  local specification relative_parent mode parent expected_metadata
  [[ "$staging_root" == /* && -d "$staging_root" && ! -L "$staging_root" ]]
  for specification in "$${manual_active_staging_parent_specs[@]}"; do
    relative_parent="$${specification%:*}"
    mode="$${specification##*:}"
    [[ "$relative_parent" =~ ^[a-z0-9][a-z0-9/-]*$ && "$relative_parent" != *//* && "$relative_parent" != */../* && "$relative_parent" != ../* && "$relative_parent" != */.. ]]
    [[ "$mode" == 0755 ]]
    parent="$staging_root/$relative_parent"
    expected_metadata="$${mode#0}:$expected_uid:$expected_gid"
    if [[ -e "$parent" || -L "$parent" ]]; then
      [[ -d "$parent" && ! -L "$parent" && "$(stat -c '%a:%u:%g' "$parent")" == "$expected_metadata" ]]
    else
      install -d -m "$mode" -o "$expected_uid" -g "$expected_gid" "$parent"
    fi
    [[ -d "$parent" && ! -L "$parent" && "$(stat -c '%a:%u:%g' "$parent")" == "$expected_metadata" ]]
  done
}

report_configure_failure() {
  python3 - "$1" "$2" "$3" "$4" <<'DIAGNOSTIC'
import hashlib
import pathlib
import sys

stage, status, stdout_path, stderr_path = sys.argv[1:]
allowed = {
    "UNIT_SETUP", "UNIT_TRANSFORM", "UNIT_SYSTEMD", "WORK_ROOT",
    "DOWNLOAD_DOCKER", "DOWNLOAD_COMPOSE", "DOWNLOAD_BACKUP", "ARCHIVE_CHECK",
    "GENERATION_STAGE", "SECRET_FETCH", "SECRET_STAGE", "DATABASE_TLS", "REDIS_TLS",
    "MANUAL_STAGE", "HELPER_SYNTAX", "DOCKER_VERSION", "COMPOSE_VERSION",
    "UNIT_VERIFICATION", "STAGED_METADATA", "CONVERGENCE", "PRE_TRANSACTION",
    "TRANSACTION", "CLEANUP", "HOST_PREREQUISITES",
}
if stage not in allowed or not status.isdecimal() or not 1 <= int(status) <= 255:
    raise SystemExit(2)
fields = [f"stage={stage}", f"status={status}"]
for label, filename in (("stdout", stdout_path), ("stderr", stderr_path)):
    # Only verifier-owned non-secret captures are supplied; other stages use no capture.
    value = b"" if filename == "-" else pathlib.Path(filename).read_bytes()
    fields.extend((f"{label}_bytes={len(value)}", f"{label}_lines={len(value.splitlines())}",
                   f"{label}_sha256={hashlib.sha256(value).hexdigest()}"))
print("IDENTITY_CONFIGURE_FAILURE " + " ".join(fields), file=sys.stderr)
DIAGNOSTIC
}

verify_staged_units() (
  set -euo pipefail
  # Do not inherit the transaction ERR handler: it would erase these captures first.
  trap - ERR
  local active_root="$1" verification_root="$2" expected_uid="$3" expected_gid="$4"
  local docker_unit_b64gzip="$5" identity_unit_b64gzip="$6"
  local copies_root="$verification_root/copies"
  local verification_stage=UNIT_SETUP verification_stdout=- verification_stderr=-
  finish_unit_verification() {
    local status=$?
    trap - EXIT ERR
    if [[ "$status" != 0 ]]; then
      report_configure_failure "$verification_stage" "$status" "$verification_stdout" "$verification_stderr"
    fi
    rm -rf -- "$verification_root"
    [[ ! -e "$verification_root" && ! -L "$verification_root" ]]
    exit "$status"
  }
  [[ "$active_root" == /* && -d "$active_root" && ! -L "$active_root" ]]
  [[ "$verification_root" == /* && -d "$verification_root" && ! -L "$verification_root" ]]
  trap finish_unit_verification EXIT
  install -d -m 0700 "$copies_root"
  verification_stage=UNIT_TRANSFORM
  verification_stdout="$verification_root/transform.stdout"
  verification_stderr="$verification_root/transform.stderr"
  python3 - "$active_root" "$copies_root" "$expected_uid" "$expected_gid" \
    "$docker_unit_b64gzip" "$identity_unit_b64gzip" \
    >"$verification_root/transform.stdout" \
    2>"$verification_root/transform.stderr" <<'PY'
import base64
import gzip
import os
import pathlib
import stat
import sys

active_root = pathlib.Path(sys.argv[1])
copies_root = pathlib.Path(sys.argv[2])
expected_uid = int(sys.argv[3])
expected_gid = int(sys.argv[4])
mapping = (
    ("docker.service", "ExecStart", "/usr/local/bin/dockerd"),
    ("identity-stack.service", "ExecStartPre", "/usr/local/libexec/platform/identity-verify-release"),
    ("identity-stack.service", "ExecStart", "/usr/local/lib/docker/cli-plugins/docker-compose"),
    ("identity-stack.service", "ExecStop", "/usr/local/lib/docker/cli-plugins/docker-compose"),
)
expected_token_counts = {
    "/usr/local/bin/dockerd": 1,
    "/usr/local/libexec/platform/identity-verify-release": 1,
    "/usr/local/lib/docker/cli-plugins/docker-compose": 2,
}
canonical_units = {
    "docker.service": gzip.decompress(base64.b64decode(sys.argv[5], validate=True)),
    "identity-stack.service": gzip.decompress(base64.b64decode(sys.argv[6], validate=True)),
}


def exact_regular(path: pathlib.Path, mode: int) -> None:
    info = path.lstat()
    if (
        not stat.S_ISREG(info.st_mode)
        or path.is_symlink()
        or (stat.S_IMODE(info.st_mode), info.st_uid, info.st_gid)
        != (mode, expected_uid, expected_gid)
    ):
        raise SystemExit(2)


def exact_ancestor_chain(path: pathlib.Path) -> None:
    relative = path.relative_to(active_root)
    current = active_root
    for part in relative.parts[:-1]:
        current /= part
        info = current.lstat()
        if not stat.S_ISDIR(info.st_mode) or current.is_symlink():
            raise SystemExit(2)


unit_names = tuple(dict.fromkeys(specification[0] for specification in mapping))
originals = {}
for unit_name in unit_names:
    staged = active_root / "etc/systemd/system" / unit_name
    exact_regular(staged, 0o644)
    staged_bytes = staged.read_bytes()
    if staged_bytes != canonical_units[unit_name]:
        raise SystemExit(2)
    originals[unit_name] = staged_bytes

all_original = b"".join(originals[name] for name in unit_names)
for token, count in expected_token_counts.items():
    if all_original.count(token.encode("ascii")) != count:
        raise SystemExit(2)

replacement_count = 0
for unit_name in unit_names:
    transformed = originals[unit_name]
    for mapped_unit, directive, token in mapping:
        if mapped_unit != unit_name:
            continue
        prefix = f"{directive}={token}".encode("ascii")
        matches = [
            line
            for line in transformed.splitlines(keepends=True)
            if line.startswith(prefix)
            and (
                len(line.rstrip(b"\r\n")) == len(prefix)
                or line[len(prefix) : len(prefix) + 1] == b" "
            )
        ]
        if len(matches) != 1 or transformed.count(prefix) != 1:
            raise SystemExit(2)
        replacement = f"{directive}={active_root}{token}".encode("ascii")
        transformed = transformed.replace(prefix, replacement, 1)
        replacement_count += 1
    destination = copies_root / unit_name
    descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, "wb") as stream:
        stream.write(transformed)

if replacement_count != 4:
    raise SystemExit(2)

for unit_name in unit_names:
    transformed = (copies_root / unit_name).read_bytes()
    reversed_bytes = transformed
    for mapped_unit, directive, token in mapping:
        if mapped_unit != unit_name:
            continue
        replacement = f"{directive}={active_root}{token}".encode("ascii")
        original = f"{directive}={token}".encode("ascii")
        if reversed_bytes.count(replacement) != 1:
            raise SystemExit(2)
        reversed_bytes = reversed_bytes.replace(replacement, original, 1)
    if reversed_bytes != originals[unit_name]:
        raise SystemExit(2)

for _, _, token in mapping:
    executable = active_root / token.removeprefix("/")
    exact_ancestor_chain(executable)
    exact_regular(executable, 0o755)
    if not os.access(executable, os.X_OK):
        raise SystemExit(2)
PY
  verification_stage=UNIT_SYSTEMD
  verification_stdout="$verification_root/systemd.stdout"
  verification_stderr="$verification_root/systemd.stderr"
  systemd-analyze --recursive-errors=yes verify \
    "$copies_root/docker.service" \
    "$copies_root/identity-stack.service" \
    >"$verification_root/systemd.stdout" \
    2>"$verification_root/systemd.stderr"
)

if [[ "$*" == --unit-verification-fixture ]]; then
  fixture_root="$PLATFORM_IDENTITY_UNIT_VERIFICATION_TEST_ROOT"
  [[ "$fixture_root" == /tmp/* && -d "$fixture_root" && ! -L "$fixture_root" ]]
  [[ "$fixture_root" == "$(realpath -e -- "$fixture_root")" ]]
  verify_staged_units \
    "$fixture_root/active" \
    "$fixture_root/verification" \
    "$(id -u)" \
    "$(id -g)" \
    "$PLATFORM_IDENTITY_DOCKER_UNIT_B64GZIP" \
    "$PLATFORM_IDENTITY_STACK_UNIT_B64GZIP"
  [[ ! -e "$fixture_root/verification" && ! -L "$fixture_root/verification" ]]
  printf 'Identity staged-unit verification fixture completed.\n'
  exit 0
fi

if [[ "$*" == --compressed-payload-fixture ]]; then
  fixture_root="$PLATFORM_IDENTITY_COMPRESSED_PAYLOAD_TEST_ROOT"
  [[ "$fixture_root" == /tmp/* && -d "$fixture_root" && ! -L "$fixture_root" ]]
  [[ "$fixture_root" == "$(realpath -e -- "$fixture_root")" ]]
  write_b64gzip "$PLATFORM_IDENTITY_COMPRESSED_PAYLOAD" "$fixture_root/result" 0600
  printf 'Identity compressed-payload fixture completed.\n'
  exit 0
fi

if [[ "$*" == --active-staging-parent-fixture ]]; then
  fixture_root="$PLATFORM_IDENTITY_STAGING_PARENT_TEST_ROOT"
  [[ "$fixture_root" == /tmp/* && -d "$fixture_root" && ! -L "$fixture_root" ]]
  [[ "$fixture_root" == "$(realpath -e -- "$fixture_root")" ]]
  fixture_active="$fixture_root/active"
  fixture_uid="$(id -u)"
  fixture_gid="$(id -g)"
  if [[ -e "$fixture_active" || -L "$fixture_active" ]]; then
    [[ -d "$fixture_active" && ! -L "$fixture_active" && "$(stat -c '%a:%u:%g' "$fixture_active")" == "755:$fixture_uid:$fixture_gid" ]]
  else
    install -d -m 0755 "$fixture_active"
  fi
  active_staging_fixture_cleanup() {
    local status="$1"
    trap - ERR
    rm -rf -- "$fixture_active"
    printf 'Identity active-staging parent fixture failed safely.\n' >&2
    exit "$status"
  }
  trap 'active_staging_fixture_cleanup $?' ERR
  prepare_manual_active_staging_parents "$fixture_active" "$fixture_uid" "$fixture_gid"
  if [[ -n "$${PLATFORM_IDENTITY_STAGING_PARENT_REMOVE_BEFORE_WRITE:-}" ]]; then
    rmdir -- "$fixture_active/$PLATFORM_IDENTITY_STAGING_PARENT_REMOVE_BEFORE_WRITE"
  fi
  fixture_payload="$(printf 'value-free staging fixture\n' | gzip --no-name | base64 -w0)"
  write_b64gzip "$fixture_payload" "$fixture_active/etc/systemd/system/identity-stack.service" 0644
  write_b64gzip "$fixture_payload" "$fixture_active/usr/local/libexec/platform/identity-verify-release" 0755
  write_b64gzip "$fixture_payload" "$fixture_active/usr/local/libexec/platform/identity-health-verify" 0755
  write_b64gzip "$fixture_payload" "$fixture_active/usr/local/libexec/platform/pgbackrest-sidecar" 0755
  write_b64gzip "$fixture_payload" "$fixture_active/etc/systemd/system/docker.service" 0644
  trap - ERR
  printf 'Identity active-staging parent fixture completed.\n'
  exit 0
fi

if [[ "$*" == --transaction-fixture ]]; then
  fixture_root="$PLATFORM_IDENTITY_CONFIGURATION_TEST_ROOT"
  [[ "$fixture_root" == /tmp/* && -d "$fixture_root" && ! -L "$fixture_root" ]]
  [[ "$fixture_root" == "$(realpath -e -- "$fixture_root")" ]]
  fixture_lock="$fixture_root/run/lock/platform-identity-lifecycle.lock"
  install -d -m 0755 "$(dirname -- "$fixture_lock")"
  exec 9>"$fixture_lock"
  flock -w 30 9
  fixture_stage="$fixture_root/stage"
  fixture_active="$fixture_root/active"
  fixture_rollback="$fixture_root/rollback"
  fixture_fail_at="$PLATFORM_IDENTITY_FAIL_AT"
  fixture_uid="$(id -u)"
  fixture_gid="$(id -g)"
  [[ -f "$fixture_stage/global-binary" && -f "$fixture_stage/global-unit" && -f "$fixture_stage/generation" ]]
  fixture_restore() {
    trap - ERR
    for name in global-binary global-unit enablement; do
      if [[ -f "$fixture_rollback/$name" ]]; then
        cp --archive -- "$fixture_rollback/$name" "$fixture_active/.$name.next"
        mv -Tf -- "$fixture_active/.$name.next" "$fixture_active/$name"
      else
        rm -f -- "$fixture_active/$name"
      fi
    done
    if [[ -f "$fixture_rollback/generation-link" ]]; then
      rm -f -- "$fixture_active/.generation-link.next"
      ln -s -- "$(<"$fixture_rollback/generation-link")" "$fixture_active/.generation-link.next"
      mv -Tf -- "$fixture_active/.generation-link.next" "$fixture_active/generation-link"
    else
      rm -f -- "$fixture_active/generation-link"
    fi
    rm -f -- "$fixture_active"/.*.next
    printf 'Identity configuration transaction fixture failed safely.\n' >&2
    exit 1
  }
  fixture_changed=false
  fixture_directory_drift=false
  if [[ -e "$fixture_active" || -L "$fixture_active" ]]; then
    if [[ ! -d "$fixture_active" || -L "$fixture_active" || "$(stat -c '%a:%u:%g' "$fixture_active")" != "755:$fixture_uid:$fixture_gid" ]]; then
      fixture_changed=true
      fixture_directory_drift=true
    fi
  else
    fixture_changed=true
  fi
  for name in global-binary global-unit; do
    if [[ ! -f "$fixture_active/$name" || -L "$fixture_active/$name" ]] \
      || [[ "$(stat -c '%a:%u:%g' "$fixture_active/$name" 2>/dev/null || true)" != "644:$fixture_uid:$fixture_gid" ]] \
      || ! cmp -s "$fixture_stage/$name" "$fixture_active/$name"; then fixture_changed=true; fi
  done
  if [[ ! -L "$fixture_active/generation-link" || "$(readlink -- "$fixture_active/generation-link" 2>/dev/null || true)" != generations/new ]]; then fixture_changed=true; fi
  if [[ ! -f "$fixture_active/enablement" || -L "$fixture_active/enablement" ]] \
    || [[ "$(stat -c '%a:%u:%g' "$fixture_active/enablement" 2>/dev/null || true)" != "600:$fixture_uid:$fixture_gid" ]] \
    || ! grep -Fxq enabled "$fixture_active/enablement"; then fixture_changed=true; fi
  if [[ "$fixture_changed" == false ]]; then
    rm -rf -- "$fixture_rollback"
    trap - ERR
    printf 'Identity configuration transaction fixture was an exact no-op.\n'
    exit 0
  fi
  if [[ "$PLATFORM_IDENTITY_FIXTURE_WORKLOAD_ACTIVE" == true ]]; then
    printf 'Identity configuration transaction fixture rejected active host-global drift.\n' >&2
    exit 1
  fi
  if [[ "$fixture_directory_drift" == true ]]; then
    printf 'Identity configuration transaction fixture rejected parent-directory metadata drift.\n' >&2
    exit 1
  fi
  install -d -m 0755 "$fixture_active"
  install -d -m 0700 "$fixture_rollback"
  trap fixture_restore ERR
  for name in global-binary global-unit enablement; do
    [[ ! -f "$fixture_active/$name" ]] || cp --archive -- "$fixture_active/$name" "$fixture_rollback/$name"
  done
  [[ ! -L "$fixture_active/generation-link" ]] || readlink -- "$fixture_active/generation-link" >"$fixture_rollback/generation-link"
  for name in global-binary global-unit; do
    install -m 0644 "$fixture_stage/$name" "$fixture_active/.$name.next"
    mv -Tf -- "$fixture_active/.$name.next" "$fixture_active/$name"
    [[ "$fixture_fail_at" != "$name" ]]
  done
  ln -s -- generations/new "$fixture_active/.generation-link.next"
  mv -Tf -- "$fixture_active/.generation-link.next" "$fixture_active/generation-link"
  [[ "$fixture_fail_at" != generation-link ]]
  printf 'enabled\n' >"$fixture_active/.enablement.next"
  mv -Tf -- "$fixture_active/.enablement.next" "$fixture_active/enablement"
  [[ "$fixture_fail_at" != enablement ]]
  rm -rf -- "$fixture_rollback"
  trap - ERR
  printf 'Identity configuration transaction fixture completed.\n'
  exit 0
fi

readonly docker_version='${docker_version}'
readonly docker_sha256='${docker_archive_sha256}'
readonly compose_version='${compose_version}'
readonly compose_sha256='${compose_binary_sha256}'
readonly pgbackrest_version='${pgbackrest_version}'
readonly pgbackrest_sha256='${pgbackrest_tar_sha256}'
readonly client_secret_arn='${bff_client_secret_arn}'
readonly database_secret_arn='${database_secret_arn}'
readonly redis_secret_arn='${redis_secret_arn}'
readonly backup_secret_arn='${backup_secret_arn}'
readonly work_root=/var/lib/platform/identity-install
readonly generation_root=/etc/platform/identity-generations
readonly lifecycle_lock=/run/lock/platform-identity-lifecycle.lock
readonly generation_name="$(date -u +%Y%m%dT%H%M%SZ)-$$"
readonly staged_generation="$work_root/generation"
readonly generation="$generation_root/$generation_name"
readonly active_generation=/etc/platform/identity
readonly unit_verification_root="$work_root/unit-verification"
configure_stage=WORK_ROOT
transaction_started=false
transaction_committed=false
work_root_owned=false
previous_generation=""
docker_was_enabled=false
stack_was_enabled=false
docker_was_active=false
stack_was_active=false
docker_was_present=false
stack_was_present=false
docker_socket_was_present=false
declare -a active_targets=()
declare -a created_directories=()
readonly -a managed_directory_specs=(
  "/opt:0755"
  "/opt/platform:0755"
  "/opt/platform/identity:0755"
  "/opt/platform/identity/releases:0755"
  "/usr/local:0755"
  "/usr/local/bin:0755"
  "/usr/local/lib:0755"
  "/usr/local/lib/docker:0755"
  "/usr/local/lib/docker/cli-plugins:0755"
  "/usr/local/libexec:0755"
  "/usr/local/libexec/platform:0755"
  "/etc:0755"
  "/etc/platform:0755"
  "/etc/systemd:0755"
  "/etc/systemd/system:0755"
  "$generation_root:0700"
)

[[ -d /run && ! -L /run && "$(stat -c '%a:%u:%g' /run)" == 755:0:0 ]]
if [[ -e /run/lock || -L /run/lock ]]; then
  [[ -d /run/lock && ! -L /run/lock && "$(stat -c '%a:%u:%g' /run/lock)" == 755:0:0 ]]
else
  install -d -o root -g root -m 0755 /run/lock
fi
exec 9>"$lifecycle_lock"
flock -w 30 9

directory_exact() {
  local directory="$1" mode="$2"
  [[ -d "$directory" && ! -L "$directory" && "$(stat -c '%a:%u:%g' "$directory")" == "$${mode#0}:0:0" ]]
}

register_directory() {
  local directory="$1" mode="$2"
  if [[ -e "$directory" || -L "$directory" ]]; then
    directory_exact "$directory" "$mode"
  else
    install -d -o root -g root -m "$mode" "$directory"
    created_directories+=("$directory")
  fi
}

atomic_file() {
  local source="$1" target="$2" mode="$3" temporary
  temporary="$(dirname -- "$target")/.$(basename -- "$target").identity.$$.next"
  rm -f -- "$temporary"
  install -m "$mode" "$source" "$temporary"
  mv -Tf -- "$temporary" "$target"
}

atomic_link() {
  local target="$1" link="$2" temporary
  temporary="$(dirname -- "$link")/.$(basename -- "$link").identity.$$.next"
  rm -f -- "$temporary"
  ln -s -- "$target" "$temporary"
  mv -Tf -- "$temporary" "$link"
}

snapshot_target() {
  local target="$1" label
  label="$(printf '%s' "$target" | sha256sum | cut -d' ' -f1)"
  active_targets+=("$target")
  if [[ -e "$target" || -L "$target" ]]; then
    [[ -f "$target" && ! -L "$target" ]]
    cp --archive -- "$target" "$work_root/rollback/$label.file"
  else
    : >"$work_root/rollback/$label.absent"
  fi
}

restore_target() {
  local target="$1" label backup temporary
  label="$(printf '%s' "$target" | sha256sum | cut -d' ' -f1)"
  backup="$work_root/rollback/$label.file"
  temporary="$(dirname -- "$target")/.$(basename -- "$target").identity.$$.next"
  rm -f -- "$temporary" || return
  if [[ -f "$backup" ]]; then
    [[ ! -L "$backup" ]] || return 1
    cp --archive -- "$backup" "$temporary" || return
    mv -Tf -- "$temporary" "$target" || return
    [[ -f "$target" && ! -L "$target" ]] || return 1
    cmp -s -- "$backup" "$target" || return
    [[ "$(stat -c '%a:%u:%g' "$backup")" == "$(stat -c '%a:%u:%g' "$target")" ]]
  else
    [[ -f "$work_root/rollback/$label.absent" && ! -L "$work_root/rollback/$label.absent" ]] || return 1
    rm -f -- "$target" || return
    [[ ! -e "$target" && ! -L "$target" ]]
  fi
}

recovery_step() {
  local label="$1" status=0
  shift
  "$@" >"$work_root/recovery.stdout" 2>"$work_root/recovery.stderr" || status=$?
  python3 - "$label" "$status" "$work_root/recovery.stdout" "$work_root/recovery.stderr" <<'RECOVERY'
import hashlib,pathlib,re,sys
label,status,*paths=sys.argv[1:]
if not re.fullmatch(r'[A-Z_]+',label) or not status.isdecimal():
    raise SystemExit(2)
fields=[f'step={label}',f'status={status}']
for name,value in zip(('stdout','stderr'),map(lambda p:pathlib.Path(p).read_bytes(),paths)):
    fields.extend((f'{name}_bytes={len(value)}',f'{name}_lines={len(value.splitlines())}',f'{name}_sha256={hashlib.sha256(value).hexdigest()}'))
print('IDENTITY_CONFIGURE_RECOVERY '+' '.join(fields),file=sys.stderr)
RECOVERY
  return "$status"
}

stop_new_unit() {
  local unit="$1" was_active="$2" active load
  [[ "$was_active" == false ]] || return 0
  active="$(systemctl show "$unit" --property=ActiveState --value)" || return
  load="$(systemctl show "$unit" --property=LoadState --value)" || return
  if [[ "$load" != not-found ]]; then
    systemctl stop "$unit" || return
  else
    [[ "$active" == inactive || "$active" == failed ]] || return 1
  fi
  active="$(systemctl show "$unit" --property=ActiveState --value)" || return
  if [[ "$active" == failed ]]; then systemctl reset-failed "$unit" || return; fi
  [[ "$(systemctl show "$unit" --property=ActiveState --value)" == inactive ]]
}

restore_unit_state() {
  local unit="$1" was_present="$2" was_enabled="$3" was_active="$4" load enabled
  load="$(systemctl show "$unit" --property=LoadState --value)" || return
  if [[ "$was_present" == false ]]; then
    [[ "$was_enabled" == false && "$was_active" == false && "$load" == not-found ]] || return 1
    # disable after removing an absent unit may fail. Reconcile only our exact link.
    local link="/etc/systemd/system/multi-user.target.wants/$unit"
    if [[ -L "$link" ]]; then
      [[ "$(readlink -- "$link")" == "/etc/systemd/system/$unit" && "$(stat -c '%u:%g' "$link")" == 0:0 ]] || return 1
      rm -- "$link" || return
    fi
    [[ ! -e "$link" && ! -L "$link" && ! -e "/etc/systemd/system/$unit" && ! -L "/etc/systemd/system/$unit" ]] || return 1
    [[ "$(systemctl show "$unit" --property=ActiveState --value)" == inactive ]]
    return
  fi
  [[ "$load" == loaded ]] || return 1
  if [[ "$was_enabled" == true ]]; then
    systemctl enable "$unit" || return
    [[ "$(systemctl is-enabled "$unit")" == enabled ]] || return 1
  else
    systemctl disable "$unit" || return
    enabled="$(systemctl show "$unit" --property=UnitFileState --value)" || return
    [[ "$enabled" == disabled ]] || return 1
  fi
  if [[ "$was_active" == true ]]; then
    systemctl start "$unit" || return
    [[ "$(systemctl show "$unit" --property=ActiveState --value)" == active ]]
  else
    [[ "$(systemctl show "$unit" --property=ActiveState --value)" == inactive ]]
  fi
}

restore_generation() {
  if [[ -n "$previous_generation" ]]; then
    atomic_link "$previous_generation" "$active_generation" || return
    [[ -L "$active_generation" && "$(readlink -- "$active_generation")" == "$previous_generation" ]]
  else
    rm -f -- "$active_generation" || return
    [[ ! -e "$active_generation" && ! -L "$active_generation" ]]
  fi
}

restore_new_socket() {
  [[ "$docker_socket_was_present" == false ]] || return 0
  python3 - <<'SOCKET'
import pathlib,stat
for path in pathlib.Path('/proc').glob('[0-9]*/comm'):
    try:
        name=path.read_text().strip()
    except FileNotFoundError:
        continue
    if name in {'dockerd','containerd','docker-proxy'} or name.startswith('containerd-shim'):
        raise SystemExit(2)
for line in pathlib.Path('/proc/net/unix').read_text().splitlines()[1:]:
    fields=line.split()
    if len(fields)==8 and fields[7] in {'/run/docker.sock','/var/run/docker.sock'} and fields[3]=='00010000':
        raise SystemExit(2)
path=pathlib.Path('/run/docker.sock')
if path.exists() or path.is_symlink():
    info=path.lstat()
    if not stat.S_ISSOCK(info.st_mode) or (info.st_uid,info.st_gid,stat.S_IMODE(info.st_mode))!=(0,0,0o660):
        raise SystemExit(2)
    path.unlink()
if path.exists() or path.is_symlink():
    raise SystemExit(2)
SOCKET
}

restore_transaction() {
  local status=0 index
  recovery_step STOP_STACK stop_new_unit identity-stack.service "$stack_was_active" || status=1
  recovery_step STOP_DOCKER stop_new_unit docker.service "$docker_was_active" || status=1
  # Never remove executable/unit files while a newly started process remains unproved.
  [[ "$status" == 0 ]] || return "$status"
  recovery_step GENERATION restore_generation || status=1
  for ((index = $${#active_targets[@]} - 1; index >= 0; index--)); do
    recovery_step FILE restore_target "$${active_targets[$index]}" || status=1
  done
  recovery_step RELOAD systemctl daemon-reload || status=1
  recovery_step DOCKER restore_unit_state docker.service "$docker_was_present" "$docker_was_enabled" "$docker_was_active" || status=1
  recovery_step STACK restore_unit_state identity-stack.service "$stack_was_present" "$stack_was_enabled" "$stack_was_active" || status=1
  recovery_step SOCKET restore_new_socket || status=1
  [[ "$status" == 0 ]] || return "$status"
  recovery_step NEW_GENERATION rm -rf -- "$generation" || status=1
  for ((index = $${#created_directories[@]} - 1; index >= 0; index--)); do
    recovery_step DIRECTORY rmdir -- "$${created_directories[$index]}" || status=1
  done
  return "$status"
}

cleanup_staging() {
  local restoration_status="$1" status=0
  # Private rollback files may be the only recovery copy: retain them on failed restoration.
  find "$work_root" -maxdepth 1 -type f -delete || status=1
  rm -rf -- "$work_root/docker" "$staged_generation" "$work_root/active" "$unit_verification_root" || status=1
  if [[ "$restoration_status" == 0 ]]; then rm -rf -- "$work_root/rollback" || status=1; fi
  [[ ! -e "$staged_generation" && ! -e "$work_root/active" && ! -e "$unit_verification_root" ]] || status=1
  [[ -z "$(find "$work_root" -maxdepth 1 -type f -print -quit)" ]] || status=1
  return "$status"
}

fail() {
  local original_status=$? restoration_status=0 cleanup_status=0
  trap - ERR
  report_configure_failure "$configure_stage" "$original_status" - -
  if [[ "$transaction_started" == true && "$transaction_committed" == false ]]; then
    restore_transaction || restoration_status=$?
  fi
  if [[ "$work_root_owned" == true ]]; then cleanup_staging "$restoration_status" || cleanup_status=$?; fi
  printf 'IDENTITY_CONFIGURE_OUTCOME original_status=%s restoration_status=%s cleanup_status=%s\n' "$original_status" "$restoration_status" "$cleanup_status" >&2
  exit "$original_status"
}
trap fail ERR

if [[ -e "$work_root" || -L "$work_root" ]]; then
  [[ -d "$work_root" && ! -L "$work_root" && "$(stat -c '%a:%u:%g' "$work_root")" == 700:0:0 ]]
else
  install -d -m 0700 "$work_root"
fi
[[ -z "$(find "$work_root" -mindepth 1 -maxdepth 1 -print -quit)" ]]
work_root_owned=true
install -d -m 0700 "$staged_generation" "$staged_generation/secrets" "$staged_generation/tls" "$work_root/active" "$work_root/rollback"

configure_stage=HOST_PREREQUISITES
write_b64gzip '${host_prepare_b64gzip}' "$work_root/host-prepare" 0755
write_b64gzip '${host_packages_b64gzip}' "$work_root/host-packages.json" 0600
bash "$work_root/host-prepare" --verify "$work_root/host-packages.json"

download_verified() {
  local url="$1" expected="$2" destination="$3" temporary="$3.part"
  curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 --output "$temporary" "$url" 2>"$work_root/download.stderr"
  printf '%s  %s\n' "$expected" "$temporary" | sha256sum --check --status
  mv -f -- "$temporary" "$destination"
  : >"$work_root/download.stderr"
}

configure_stage=DOWNLOAD_DOCKER
download_verified "https://download.docker.com/linux/static/stable/aarch64/docker-$${docker_version}.tgz" "$docker_sha256" "$work_root/docker.tgz"
tar --extract --gzip --file "$work_root/docker.tgz" --directory "$work_root"
for binary in containerd containerd-shim-runc-v2 ctr docker dockerd docker-init docker-proxy runc; do
  [[ -f "$work_root/docker/$binary" && ! -L "$work_root/docker/$binary" && -x "$work_root/docker/$binary" ]]
  install -D -m 0755 "$work_root/docker/$binary" "$work_root/active/usr/local/bin/$binary"
done
configure_stage=DOWNLOAD_COMPOSE
download_verified "https://github.com/docker/compose/releases/download/v$${compose_version}/docker-compose-linux-aarch64" "$compose_sha256" "$work_root/docker-compose"
install -D -m 0755 "$work_root/docker-compose" "$work_root/active/usr/local/lib/docker/cli-plugins/docker-compose"
configure_stage=DOWNLOAD_BACKUP
download_verified "https://github.com/pgbackrest/pgbackrest/releases/download/release%2F$${pgbackrest_version}/pgbackrest-$${pgbackrest_version}.tar.gz" "$pgbackrest_sha256" "$work_root/pgbackrest.tar.gz"
install -D -m 0644 "$work_root/pgbackrest.tar.gz" "$work_root/active/opt/platform/identity/pgbackrest-$${pgbackrest_version}.tar.gz"

configure_stage=ARCHIVE_CHECK
python3 - "$work_root/docker.tgz" "$work_root/pgbackrest.tar.gz" <<'PY'
import pathlib
import sys
import tarfile
for value in sys.argv[1:]:
    with tarfile.open(value, "r:gz") as archive:
        members = archive.getmembers()
        if not members:
            raise SystemExit(2)
        for member in members:
            path = pathlib.PurePosixPath(member.name)
            if path.is_absolute() or ".." in path.parts or member.issym() or member.islnk() or member.isdev():
                raise SystemExit(2)
PY

configure_stage=GENERATION_STAGE
install -d -m 0755 "$staged_generation/secrets" "$staged_generation/tls"
install -d -m 0750 -o root -g 10002 "$staged_generation/secrets/client" "$staged_generation/secrets/redis-client" "$staged_generation/tls/redis-client"
install -d -m 0750 -o root -g 10001 "$staged_generation/secrets/database" "$staged_generation/tls/postgres-client"
install -d -m 0750 -o root -g 999 "$staged_generation/secrets/database-server" "$staged_generation/secrets/redis-server" "$staged_generation/tls/redis-server" "$staged_generation/tls/postgres-server"
install -d -m 0750 -o root -g 65532 "$staged_generation/secrets/backup"

write_b64gzip '${compose_b64gzip}' "$staged_generation/compose.yml" 0644
write_b64gzip '${nginx_b64gzip}' "$staged_generation/identity-runtime.conf.staged" 0644
write_b64gzip '${pgbackrest_b64gzip}' "$staged_generation/pgbackrest.conf" 0440
chown root:65532 "$staged_generation/pgbackrest.conf"
write_b64gzip '${postgres_roles_b64gzip}' "$staged_generation/postgres-roles.sql" 0600
write_b64gzip '${postgres_hba_b64gzip}' "$staged_generation/postgres-hba.conf" 0644
write_b64gzip '${pgbackrest_passwd_b64gzip}' "$staged_generation/pgbackrest-passwd" 0644
write_b64gzip '${launcher_b64gzip}' "$staged_generation/identity-launcher.py" 0555

fetch_secret() {
  local secret_arn="$1" destination="$2"
  [[ -n "$secret_arn" ]]
  aws secretsmanager get-secret-value --region ap-south-1 --secret-id "$secret_arn" --version-stage AWSCURRENT --query SecretString --output text >"$destination" 2>"$work_root/secret.stderr"
  chmod 0600 "$destination"
  : >"$work_root/secret.stderr"
}
configure_stage=SECRET_FETCH
fetch_secret "$client_secret_arn" "$work_root/client.json"
fetch_secret "$database_secret_arn" "$work_root/database.json"
fetch_secret "$redis_secret_arn" "$work_root/redis.json"
fetch_secret "$backup_secret_arn" "$work_root/backup.json"

configure_stage=SECRET_STAGE
python3 - "$work_root" "$staged_generation" 2>"$work_root/secret.stderr" <<'PY'
import json
import os
import pathlib
import re
import sys
work = pathlib.Path(sys.argv[1])
generation = pathlib.Path(sys.argv[2])
schemas = {
    "client": {"client_secret"},
    "database": {"bootstrap_password", "migrator_password", "runtime_password", "postgres_ca_crt", "postgres_server_crt", "postgres_server_key"},
    "redis": {"bff_password", "redis_ca_crt", "redis_server_crt", "redis_server_key"},
    "backup": {"repository_cipher"},
}
def no_duplicates(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate")
        result[key] = value
    return result
objects = {}
for name, fields in schemas.items():
    with (work / f"{name}.json").open("r", encoding="utf-8") as handle:
        value = json.load(handle, object_pairs_hook=no_duplicates)
    if not isinstance(value, dict) or set(value) != fields or any(not isinstance(item, str) or not item for item in value.values()):
        raise SystemExit(2)
    objects[name] = value
for name, fields in (("database", ("postgres_ca_crt", "postgres_server_crt", "postgres_server_key")), ("redis", ("redis_ca_crt", "redis_server_crt", "redis_server_key"))):
    for field in fields:
        encoded = objects[name][field].encode("ascii", "strict")
        if not 256 <= len(encoded) <= 32768 or b"\r" in encoded or b"\x00" in encoded:
            raise SystemExit(2)
credential = re.compile(r"[A-Za-z0-9!#$%&()*+,./:;<=>?@\[\]^_`{|}~-]{32,256}")
for name, field in (("client", "client_secret"), ("database", "bootstrap_password"), ("database", "migrator_password"), ("database", "runtime_password"), ("redis", "bff_password"), ("backup", "repository_cipher")):
    if not credential.fullmatch(objects[name][field]):
        raise SystemExit(2)
def write(relative, value, gid, mode=0o440, uid=0):
    target = generation / relative
    descriptor = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    os.fchown(descriptor, uid, gid)
    os.fchmod(descriptor, mode)
    with os.fdopen(descriptor, "w", encoding="ascii", newline="") as stream:
        stream.write(value)
write("secrets/client/client_secret", objects["client"]["client_secret"], 10002)
write("secrets/database-server/bootstrap_password", objects["database"]["bootstrap_password"], 999)
for field in ("migrator_password", "runtime_password"):
    write(f"secrets/database/{field}", objects["database"][field], 10001)
for field, output in (("postgres_ca_crt", "ca.crt"), ("postgres_server_crt", "server.crt"), ("postgres_server_key", "server.key")):
    write(f"tls/postgres-server/{output}", objects["database"][field], 999)
write("tls/postgres-client/ca.crt", objects["database"]["postgres_ca_crt"], 10001)
write("secrets/redis-server/bff_password", objects["redis"]["bff_password"], 999)
write("secrets/redis-client/bff_password", objects["redis"]["bff_password"], 10002)
for field, output in (("redis_ca_crt", "ca.crt"), ("redis_server_crt", "server.crt"), ("redis_server_key", "server.key")):
    write(f"tls/redis-server/{output}", objects["redis"][field], 999)
write("tls/redis-client/ca.crt", objects["redis"]["redis_ca_crt"], 10002)
write("secrets/backup/repository_cipher", objects["backup"]["repository_cipher"], 65532)
escaped = objects["database"]["bootstrap_password"].replace("\\", "\\\\").replace(":", "\\:")
write("secrets/database/bootstrap.pgpass", f"postgres:5432:identity:identity_bootstrap:{escaped}\n", 10001, 0o600, 10001)
acl = "user default off\n" + f"user portfolio_bff reset on >{objects['redis']['bff_password']} ~reference-bff:production:portfolio:identity:* +ping +get +set +getdel +del +eval +client|setinfo\n"
write("secrets/redis-server/users.acl", acl, 999)
PY

validate_server_identity() {
  local directory="$1" hostname="$2"
  openssl x509 -in "$directory/ca.crt" -noout -ext basicConstraints >"$work_root/ca-basic" 2>/dev/null
  openssl x509 -in "$directory/ca.crt" -noout -ext keyUsage >"$work_root/ca-usage" 2>/dev/null
  grep -Fq 'CA:TRUE' "$work_root/ca-basic"
  grep -Fq 'Certificate Sign' "$work_root/ca-usage"
  openssl pkey -in "$directory/server.key" -noout >/dev/null 2>&1
  openssl verify -CAfile "$directory/ca.crt" "$directory/server.crt" >/dev/null 2>&1
  openssl x509 -in "$directory/server.crt" -checkhost "$hostname" -noout >/dev/null 2>&1
  openssl x509 -in "$directory/server.crt" -purpose -noout 2>/dev/null | grep -Fxq 'SSL server : Yes'
  openssl x509 -in "$directory/server.crt" -pubkey -noout 2>/dev/null | sha256sum | cut -d' ' -f1 >"$work_root/cert.pub"
  openssl pkey -in "$directory/server.key" -pubout 2>/dev/null | sha256sum | cut -d' ' -f1 >"$work_root/key.pub"
  cmp -s "$work_root/cert.pub" "$work_root/key.pub"
}
configure_stage=DATABASE_TLS
validate_server_identity "$staged_generation/tls/postgres-server" postgres
configure_stage=REDIS_TLS
validate_server_identity "$staged_generation/tls/redis-server" redis

configure_stage=MANUAL_STAGE
prepare_manual_active_staging_parents "$work_root/active" 0 0
write_b64gzip '${systemd_unit_b64gzip}' "$work_root/active/etc/systemd/system/identity-stack.service" 0644
write_b64gzip '${verify_release_b64gzip}' "$work_root/active/usr/local/libexec/platform/identity-verify-release" 0755
write_b64gzip '${health_verify_b64gzip}' "$work_root/active/usr/local/libexec/platform/identity-health-verify" 0755
write_b64gzip '${pgbackrest_sidecar_b64gzip}' "$work_root/active/usr/local/libexec/platform/pgbackrest-sidecar" 0755
write_b64gzip '${docker_service_b64gzip}' "$work_root/active/etc/systemd/system/docker.service" 0644
configure_stage=HELPER_SYNTAX
bash -n "$work_root/active/usr/local/libexec/platform/identity-verify-release"
bash -n "$work_root/active/usr/local/libexec/platform/identity-health-verify"
bash -n "$work_root/active/usr/local/libexec/platform/pgbackrest-sidecar"
configure_stage=DOCKER_VERSION
"$work_root/active/usr/local/bin/docker" --version >/dev/null
configure_stage=COMPOSE_VERSION
"$work_root/active/usr/local/lib/docker/cli-plugins/docker-compose" version >/dev/null
configure_stage=UNIT_VERIFICATION
install -d -m 0700 "$unit_verification_root"
verify_staged_units \
  "$work_root/active" \
  "$unit_verification_root" \
  0 \
  0 \
  '${docker_service_b64gzip}' \
  '${systemd_unit_b64gzip}'
[[ ! -e "$unit_verification_root" && ! -L "$unit_verification_root" ]]

configure_stage=STAGED_METADATA
python3 - "$staged_generation" "$work_root/active" <<'PY'
import os
import pathlib
import stat
import sys
pgpass = pathlib.Path(sys.argv[1]) / "secrets/database/bootstrap.pgpass"
for root_name in sys.argv[1:]:
    root = pathlib.Path(root_name)
    for path in root.rglob("*"):
        info = path.lstat()
        if stat.S_ISLNK(info.st_mode) or not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
            raise SystemExit(2)
        expected_uid = 10001 if path == pgpass else 0
        if info.st_uid != expected_uid:
            raise SystemExit(2)
for path in (pathlib.Path(sys.argv[1]) / "secrets").rglob("*"):
    if path.is_file():
        info = path.stat()
        if path == pgpass:
            if (stat.S_IMODE(info.st_mode), info.st_uid, info.st_gid) != (0o600, 10001, 10001):
                raise SystemExit(2)
        elif stat.S_IMODE(info.st_mode) != 0o440 or info.st_uid != 0:
            raise SystemExit(2)
PY

configure_stage=CONVERGENCE
mapfile -t staged_files < <(find "$work_root/active" -type f -print | LC_ALL=C sort)
all_active_equal=true
for source in "$${staged_files[@]}"; do
  target="/$${source#"$work_root/active/"}"
  source_metadata="$(stat -c '%a:%u:%g' "$source")"
  if [[ ! -f "$target" || -L "$target" ]] \
    || [[ "$(stat -c '%a:%u:%g' "$target" 2>/dev/null || true)" != "$source_metadata" ]] \
    || ! cmp -s "$source" "$target"; then
    all_active_equal=false
  fi
done

all_directories_equal=true
for specification in "$${managed_directory_specs[@]}"; do
  directory="$${specification%:*}"
  mode="$${specification##*:}"
  if ! directory_exact "$directory" "$mode"; then all_directories_equal=false; fi
done

current_generation=""
if [[ -L "$active_generation" ]]; then
  current_generation="$(readlink -f -- "$active_generation")"
  [[ "$current_generation" == "$generation_root"/* && -d "$current_generation" && ! -L "$current_generation" ]]
  [[ "$(stat -c '%a:%u:%g' "$current_generation")" == 700:0:0 ]]
fi
generation_equal=false
if [[ -n "$current_generation" ]]; then
  if python3 - "$staged_generation" "$current_generation" <<'PY'
import filecmp
import os
import pathlib
import stat
import sys
left, right = map(pathlib.Path, sys.argv[1:])
def inventory(root):
    result = {}
    for path in root.rglob("*"):
        relative = path.relative_to(root).as_posix()
        info = path.lstat()
        if stat.S_ISLNK(info.st_mode):
            raise SystemExit(2)
        result[relative] = (stat.S_IFMT(info.st_mode), stat.S_IMODE(info.st_mode), info.st_uid, info.st_gid, info.st_size if path.is_file() else None)
    return result
if inventory(left) != inventory(right):
    raise SystemExit(1)
for path in left.rglob("*"):
    if path.is_file() and not filecmp.cmp(path, right / path.relative_to(left), shallow=False):
        raise SystemExit(1)
PY
  then generation_equal=true; fi
fi

docker_enabled=false; stack_enabled=false
[[ "$(systemctl is-enabled docker.service 2>/dev/null || true)" == enabled ]] && docker_enabled=true
[[ "$(systemctl is-enabled identity-stack.service 2>/dev/null || true)" == enabled ]] && stack_enabled=true
if [[ "$all_active_equal" == true && "$all_directories_equal" == true && "$generation_equal" == true && "$docker_enabled" == true && "$stack_enabled" == true ]]; then
  rm -rf -- "$work_root"/*
  trap - ERR
  printf 'Identity runtime configuration already matches the active generation; no services changed.\n'
  exit 0
fi

configure_stage=PRE_TRANSACTION
if systemctl is-active --quiet identity-stack.service; then
  printf 'Active Identity workload requires a separately reviewed host maintenance operation.\n' >&2
  exit 1
fi

if [[ -L "$active_generation" ]]; then previous_generation="$(readlink -- "$active_generation")"; elif [[ -e "$active_generation" ]]; then exit 1; fi
if [[ -e /run/docker.sock || -L /run/docker.sock ]]; then
  [[ -S /run/docker.sock && ! -L /run/docker.sock && "$(stat -c '%a:%u:%g' /run/docker.sock)" == 660:0:0 ]]
  docker_socket_was_present=true
fi
for unit in docker.service identity-stack.service; do
  load="$(systemctl show "$unit" --property=LoadState --value)"
  active="$(systemctl show "$unit" --property=ActiveState --value)"
  [[ "$active" == active || "$active" == inactive ]]
  if [[ "$load" == loaded ]]; then
    [[ "$(systemctl show "$unit" --property=FragmentPath --value)" == "/etc/systemd/system/$unit" ]]
    [[ -f "/etc/systemd/system/$unit" && ! -L "/etc/systemd/system/$unit" ]]
    if [[ "$unit" == docker.service ]]; then docker_was_present=true; else stack_was_present=true; fi
  else
    [[ "$load" == not-found && "$active" == inactive ]]
    [[ ! -e "/etc/systemd/system/multi-user.target.wants/$unit" && ! -L "/etc/systemd/system/multi-user.target.wants/$unit" ]]
  fi
done
systemctl is-enabled --quiet docker.service 2>/dev/null && docker_was_enabled=true || true
systemctl is-enabled --quiet identity-stack.service 2>/dev/null && stack_was_enabled=true || true
systemctl is-active --quiet docker.service && docker_was_active=true || true
systemctl is-active --quiet identity-stack.service && stack_was_active=true || true
for source in "$${staged_files[@]}"; do
  target="/$${source#"$work_root/active/"}"
  snapshot_target "$target"
done

configure_stage=TRANSACTION
transaction_started=true
for specification in "$${managed_directory_specs[@]}"; do
  directory="$${specification%:*}"
  mode="$${specification##*:}"
  register_directory "$directory" "$mode"
done
mv -- "$staged_generation" "$generation"
for source in "$${staged_files[@]}"; do
  target="/$${source#"$work_root/active/"}"
  mode="$(stat -c '%a' "$source")"
  atomic_file "$source" "$target" "$mode"
done
atomic_link "identity-generations/$generation_name" "$active_generation"
systemctl daemon-reload
systemctl enable docker.service identity-stack.service
systemctl start docker.service
[[ "$(systemctl is-enabled identity-stack.service)" == enabled ]]
! systemctl is-active --quiet identity-stack.service
transaction_committed=true

configure_stage=CLEANUP
rm -rf -- "$work_root"/*
trap - ERR
printf 'Identity runtime source configured transactionally; no workload was started.\n'
