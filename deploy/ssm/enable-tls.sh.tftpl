#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

if ((EUID != 0)); then
  printf '%s\n' 'TLS enablement must run as root' >&2
  exit 1
fi

readonly configured_base_domain='${configured_base_domain}'
readonly base_domain="$${SSM_BaseDomain:-}"
readonly acme_email="$${SSM_AcmeEmail:-}"
readonly expected_elastic_ip="$${SSM_ExpectedElasticIP:-}"
readonly certbot=/opt/platform/certbot-5.7.0/bin/certbot
readonly acme_root=/var/lib/platform/acme
readonly nginx_config=/etc/nginx/conf.d/portfolio.conf
readonly work_dir="$(mktemp -d /var/lib/platform/tls.XXXXXX)"
readonly prior_config="$work_dir/portfolio-http.conf"
readonly probe_name="phase-3a-$RANDOM-$RANDOM"
readonly probe_path="$acme_root/.well-known/acme-challenge/$probe_name"
tls_config_installed=0

[[ "$base_domain" == "$configured_base_domain" ]]
[[ "$base_domain" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]]
[[ "$acme_email" =~ ^[A-Za-z0-9.!#$%\&*+/=?^_\`\{\|\}~-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]]
python3 - "$expected_elastic_ip" <<'PYTHON'
import ipaddress
import sys
value = ipaddress.ip_address(sys.argv[1])
if value.version != 4:
    raise SystemExit("expected address is not IPv4")
PYTHON
[[ -x "$certbot" ]]
[[ -f "$nginx_config" ]]
cp -- "$nginx_config" "$prior_config"

cleanup() {
  local status=$?
  rm -f -- "$probe_path"
  if ((status != 0 && tls_config_installed == 1)); then
    install -o root -g root -m 0644 "$prior_config" "$nginx_config"
    if nginx -t; then
      systemctl reload nginx.service
    fi
  fi
  rm -rf -- "$work_dir"
  exit "$status"
}
trap cleanup EXIT

python3 - "$base_domain" "$expected_elastic_ip" <<'PYTHON'
import ipaddress
import random
import socket
import struct
import sys
import time
import urllib.request

zone = sys.argv[1].rstrip(".")
expected = str(ipaddress.ip_address(sys.argv[2]))
max_cname_depth = 8
maximum_attempts = 6
retry_delay_seconds = 10
google_doh_endpoint = "https://dns.google/dns-query"
cloudflare_doh_endpoint = "https://cloudflare-dns.com/dns-query"

def encode_name(name):
    return b"".join(bytes([len(label)]) + label.encode("ascii") for label in name.rstrip(".").split(".")) + b"\0"

def decode_name(message, offset):
    labels = []
    jumped = False
    final_offset = offset
    seen = set()
    while True:
        if offset in seen:
            raise RuntimeError("DNS compression loop")
        seen.add(offset)
        if offset >= len(message):
            raise RuntimeError("truncated DNS name")
        length = message[offset]
        if length == 0:
            if not jumped:
                final_offset = offset + 1
            return ".".join(labels), final_offset
        if length & 0xC0 == 0xC0:
            if offset + 1 >= len(message):
                raise RuntimeError("truncated DNS pointer")
            pointer = ((length & 0x3F) << 8) | message[offset + 1]
            if pointer >= len(message):
                raise RuntimeError("invalid DNS pointer")
            if not jumped:
                final_offset = offset + 2
            offset = pointer
            jumped = True
            continue
        if length & 0xC0 or length > 63 or offset + 1 + length > len(message):
            raise RuntimeError("invalid DNS label")
        offset += 1
        labels.append(message[offset:offset + length].decode("ascii"))
        offset += length
        if not jumped:
            final_offset = offset

def build_query(name, record_type):
    identifier = random.SystemRandom().randrange(0, 65536)
    packet = struct.pack("!HHHHHH", identifier, 0x0100, 1, 0, 0, 0) + encode_name(name) + struct.pack("!HH", record_type, 1)
    return identifier, packet

def parse_response(response, identifier):
    if len(response) < 12:
        raise RuntimeError("truncated DNS response")
    header = struct.unpack("!HHHHHH", response[:12])
    flags = header[1]
    if header[0] != identifier or not flags & 0x8000:
        raise RuntimeError("invalid DNS response")
    if flags & 0x0200:
        raise RuntimeError("truncated DNS response")
    if flags & 0x000F:
        raise RuntimeError("unexpected DNS response code")
    offset = 12
    for _ in range(header[2]):
        _, offset = decode_name(response, offset)
        if offset + 4 > len(response):
            raise RuntimeError("truncated DNS question")
        offset += 4
    records = []
    for section, count in (("answer", header[3]), ("authority", header[4]), ("additional", header[5])):
        for _ in range(count):
            owner, offset = decode_name(response, offset)
            if offset + 10 > len(response):
                raise RuntimeError("truncated DNS record")
            record_type, record_class, _ttl, length = struct.unpack("!HHIH", response[offset:offset + 10])
            offset += 10
            data_offset = offset
            if offset + length > len(response):
                raise RuntimeError("truncated DNS record data")
            raw = response[offset:offset + length]
            offset += length
            if section != "answer" or record_class != 1:
                continue
            if record_type == 1 and length == 4:
                value = str(ipaddress.ip_address(raw))
            elif record_type == 28 and length == 16:
                value = str(ipaddress.ip_address(raw))
            elif record_type == 5:
                value, _ = decode_name(response, data_offset)
                value = value.rstrip(".").lower()
            else:
                continue
            records.append((owner.rstrip(".").lower(), record_type, value))
    return records

def query_udp(server, name, record_type):
    identifier, packet = build_query(name, record_type)
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as client:
        client.settimeout(8)
        client.sendto(packet, (server, 53))
        response, _ = client.recvfrom(65535)
    return parse_response(response, identifier)

def query_doh(endpoint, name, record_type):
    identifier, packet = build_query(name, record_type)
    request = urllib.request.Request(
        endpoint,
        data=packet,
        method="POST",
        headers={
            "Accept": "application/dns-message",
            "Content-Type": "application/dns-message",
            "User-Agent": "platform-infrastructure-tls-validation/1.0",
        },
    )
    with urllib.request.urlopen(request, timeout=8) as response:
        if not response.headers.get_content_type() == "application/dns-message":
            raise RuntimeError("unexpected DoH content type")
        payload = response.read(65535)
    return parse_response(payload, identifier)

def resolve_final(query, hostname):
    current = hostname.rstrip(".").lower()
    visited = set()
    for depth in range(max_cname_depth + 1):
        if current in visited:
            raise RuntimeError("CNAME cycle")
        visited.add(current)
        addresses = {1: set(), 28: set()}
        aliases = set()
        for record_type in (1, 28):
            for owner, observed_type, value in query(current, record_type):
                if owner != current:
                    continue
                if observed_type in addresses:
                    addresses[observed_type].add(value)
                elif observed_type == 5:
                    aliases.add(value)
        if aliases:
            if len(aliases) != 1 or depth == max_cname_depth:
                raise RuntimeError("invalid or over-depth CNAME chain")
            current = next(iter(aliases))
            continue
        return addresses[1], addresses[28]
    raise RuntimeError("CNAME depth exceeded")

vpc_resolver = None
with open("/etc/resolv.conf", encoding="utf-8") as handle:
    for line in handle:
        fields = line.split()
        if len(fields) == 2 and fields[0] == "nameserver":
            try:
                address = ipaddress.ip_address(fields[1])
            except ValueError:
                continue
            if address.version == 4:
                vpc_resolver = str(address)
                break
if vpc_resolver is None:
    raise SystemExit("no IPv4 recursive resolver is configured")

perspectives = (
    ("VPC resolver", lambda name, record_type: query_udp(vpc_resolver, name, record_type)),
    ("Google DoH", lambda name, record_type: query_doh(google_doh_endpoint, name, record_type)),
    ("Cloudflare DoH", lambda name, record_type: query_doh(cloudflare_doh_endpoint, name, record_type)),
)

for attempt in range(1, maximum_attempts + 1):
    all_valid = True
    for resolver_name, query in perspectives:
        for hostname in (zone, "www." + zone):
            try:
                ipv4, ipv6 = resolve_final(query, hostname)
            except Exception:
                print(f"DNS resolver={resolver_name} host={hostname} A=unavailable AAAA=unavailable")
                all_valid = False
                continue
            observed_ipv4 = ",".join(sorted(ipv4)) if ipv4 else "none"
            observed_ipv6 = ",".join(sorted(ipv6)) if ipv6 else "none"
            print(f"DNS resolver={resolver_name} host={hostname} A={observed_ipv4} AAAA={observed_ipv6}")
            if ipv4 != {expected} or ipv6:
                all_valid = False
    if all_valid:
        print("DNS resolver agreement passed")
        break
    if attempt == maximum_attempts:
        raise SystemExit("recursive DNS perspectives did not converge")
    time.sleep(retry_delay_seconds)
PYTHON

install -d -o root -g nginx -m 0750 "$(dirname "$probe_path")"
printf '%s\n' "$probe_name" >"$probe_path"
chown root:nginx "$probe_path"
chmod 0440 "$probe_path"

[[ "$(curl --silent --show-error --fail --max-time 15 --resolve "$${base_domain}:80:127.0.0.1" "http://$${base_domain}/.well-known/acme-challenge/$${probe_name}")" == "$probe_name" ]]
[[ "$(curl --silent --show-error --fail --max-time 15 --resolve "www.$${base_domain}:80:127.0.0.1" "http://www.$${base_domain}/.well-known/acme-challenge/$${probe_name}")" == "$probe_name" ]]

"$certbot" certonly \
  --staging \
  --non-interactive \
  --agree-tos \
  --no-eff-email \
  --email "$acme_email" \
  --webroot \
  --webroot-path "$acme_root" \
  --domains "$base_domain" \
  --domains "www.$base_domain" \
  --config-dir /etc/letsencrypt-staging \
  --work-dir /var/lib/letsencrypt-staging \
  --logs-dir /var/log/letsencrypt-staging

"$certbot" certonly \
  --non-interactive \
  --agree-tos \
  --no-eff-email \
  --email "$acme_email" \
  --webroot \
  --webroot-path "$acme_root" \
  --domains "$base_domain" \
  --domains "www.$base_domain"

temporary_config="$work_dir/portfolio-tls.conf"
base64 --decode <<'TLS_CONFIGURATION' >"$temporary_config"
${tls_conf_b64}
TLS_CONFIGURATION
install -o root -g root -m 0644 "$temporary_config" "$nginx_config"
tls_config_installed=1

nginx -t
systemctl reload nginx.service
"$certbot" renew --dry-run

printf 'TLS enabled for the configured apex and www names at %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
